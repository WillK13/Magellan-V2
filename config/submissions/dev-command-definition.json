{
  "definition_id": "generic-command-counter",
  "profile": {
    "workload_type": "generic-command",
    "power_kw": 0.1,
    "checkpoint_bytes": 1024,
    "data_bytes": 0,
    "prestaged_node_ids": ["boston", "virginia"],
    "estimated_remaining_seconds": 3600,
    "accumulated_cost_usd": 0,
    "cost_cap_usd": 1,
    "priority": 10,
    "deadline_at_utc": null,
    "resource_request": {
      "cpu_cores": 1,
      "memory_mb": 256,
      "gpu_count": 0,
      "accelerator_type": null
    },
    "compatibility": {
      "architectures": ["x86_64"],
      "operating_systems": ["linux"],
      "required_commands": ["python3"],
      "required_runtimes": {"python": ">=3.11,<3.12"},
      "required_features": ["local-command", "process-group"]
    }
  },
  "runtime": {
    "adapter": "command",
    "command": ["python3", "-m", "magellan.workloads.counter"],
    "arguments": [
      "--checkpoint-file", "{checkpoint_file}",
      "--interval-seconds", "0.2",
      "--max-value", "180",
      "--progress-file", "{progress_file}",
      "--completion-file", "{completion_file}",
      "--output-dir", "{output_directory}"
    ],
    "environment": {},
    "working_directory": ".",
    "checkpoint_relative_path": "checkpoint/counter.json",
    "checkpoint_manifest_relative_path": null,
    "readiness_relative_path": null,
    "readiness_timeout_seconds": 30,
    "progress_relative_path": "runtime/progress.json",
    "completion_relative_path": "runtime/completion.json",
    "output_relative_directory": "output",
    "stop_timeout_seconds": 10,
    "minimum_process_count": 1
  },
  "artifacts": []
}
